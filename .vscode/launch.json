{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Web App – Firefox",
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "url": "http://localhost:8080/",
      "webRoot": "${workspaceFolder}/web-app",
      "profile": "dev-edition-default",
      "keepProfileChanges": true,
      "preLaunchTask": "Start Web App Server"
    }
  ]
}
